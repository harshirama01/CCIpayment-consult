# Copy to .env.local for local testing. On Vercel set these under Settings -> Environment Variables.
# Both IDs have built-in defaults; set these only to override. NEXT_PUBLIC_* values are baked in at build time, so redeploy after changing them.

# Google Analytics 4 Measurement ID. Optional: defaults to the ID built into components/Analytics.tsx.
# Set it only to override that (e.g. a different property for testing).
NEXT_PUBLIC_GA_ID=

# Meta (Facebook) Pixel ID (a number). Optional: defaults to the ID built into components/Analytics.tsx.
NEXT_PUBLIC_META_PIXEL_ID=
